<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>minef</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Paper 26.2 требует JDK 25 -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Официальный репозиторий MCProtocolLib (релизы) -->
        <repository>
            <id>opencollab</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
        <!--
          Пока нет тегированного релиза под 26.2, можно попробовать
          снапшот-сборки - иногда там уже есть версия с поддержкой
          самой свежей Minecraft, до её официального релиза.
        -->
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <!--
              ВАЖНО: версия здесь должна совпадать с версией сервера, на
              которой вы фактически остановитесь - см. пояснение к
              MCProtocolLib ниже. Если решите пока сидеть на 26.1 (пункт 1),
              поменяйте на [26.1.build,).
            -->
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>[26.2.build,)</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <!--
              В официальном репозитории GeyserMC/MCProtocolLib есть ветка
              feature/26.2 с работой над этой версией - она ещё не влита в
              master и не опубликована в Maven как отдельный релиз/снапшот.
              Собираем и публикуем её в локальный репозиторий (шаги ниже,
              в README), затем сюда подставляем версию, которую увидите в
              выводе сборки - обычно она берётся из gradle.properties той
              ветки и выглядит как "26.2-SNAPSHOT" или похоже, но нужно
              свериться по факту после клонирования.
            -->
            <groupId>org.geysermc.mcprotocollib</groupId>
            <artifactId>protocol</artifactId>
            <version>26.2-SNAPSHOT</version>
        </dependency>

        <dependency>
            <!--
              Явно добавляем сериализатор Adventure-компонентов в plain-текст -
              используется только для читаемого логирования причины
              отключения (Component -> String). Версия должна совпадать с
              той, что использует сама ветка feature/26.2 (см. gradle/libs.versions.toml
              в исходниках MCProtocolLib - там "adventure = 5.2.0").
            -->
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-plain</artifactId>
            <version>5.2.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>minef</finalName>
        <plugins>
            <!-- Собираем MCProtocolLib и все его зависимости внутрь итогового jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
